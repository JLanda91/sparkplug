{
  "version": 6,
  "configurePresets": [
    {
      "hidden": true,
      "name": "env",
      "cacheVariables": {
        "VCPKG_MANIFEST_INSTALL": "ON"
      },
      "environment": {
        "NVCOMPILERS": "/usr/local/cuda",
        "VCPKG_ROOT": "/opt/vcpkg"
      }
    },
    {
      "name": "gcc-10",
      "inherits": ["env", "base", "release", "gcc"],
      "displayName": "GCC 10",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-10",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-10"
      }
    },
    {
      "name": "gcc-11",
      "inherits": ["env", "base", "release", "gcc"],
      "displayName": "GCC 11",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-11",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-11"
      }
    },
    {
      "name": "gcc-12",
      "inherits": ["env", "base", "release", "gcc"],
      "displayName": "GCC 12",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-12",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-12"
      }
    },
    {
      "name": "gcc-13",
      "inherits": ["env", "base", "release", "gcc"],
      "displayName": "GCC 13",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-13",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-13"
      }
    },
    {
      "name": "gcc-14",
      "inherits": ["env", "base", "release", "gcc"],
      "displayName": "GCC 14",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-14",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-14"
      }
    }
  ]
}